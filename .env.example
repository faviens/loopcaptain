# Both are optional. The board runs without a .env file.

# Path of the config that lists the watched repositories.
# Default: loopcaptain.local.yaml in the folder the board is started in.
LOOPCAPTAIN_CONFIG=

# Folder for the pid records and logs of loops the board started.
# Default: .state in the folder the board is started in.
LOOPCAPTAIN_STATE=

# Folders, separated by ":", under which the MCP tools may write besides the
# folder the server was started in.
LOOPCAPTAIN_MCP_ROOTS=

# The key the board signs inbox lines with. Default: ~/.config/loopcaptain/inbox.key
LOOPCAPTAIN_INBOX_KEY=
