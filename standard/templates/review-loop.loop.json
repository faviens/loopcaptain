{
  "protocol": 1,
  "id": "review-loop",
  "title": "A review loop: one maker, reviewers, a gate",
  "brief": {
    "goal": "What is being improved round by round",
    "audience": "Who it is for",
    "bar": "No material finding is open and the gate passes"
  },
  "steps": [
    {"id": "make", "kind": "build", "name": "Maker", "purpose": "Changes the work to close the open findings"},
    {"id": "review-correctness", "kind": "review", "name": "correctness", "after": ["make"]},
    {"id": "review-reader", "kind": "review", "name": "first reader", "after": ["make"]},
    {"id": "gate", "kind": "gate", "name": "Gate", "after": ["review-correctness", "review-reader"], "purpose": "Tests, lint, links"},
    {"id": "verdict", "kind": "verdict", "name": "Decide"}
  ],
  "round_cap": 8,
  "runtime_cap_minutes": 120,
  "commands": {"start": "make loop"}
}
