        "item": {
          "title": "Item",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "partly",
            "fail",
            "blocked"
          ],
          "title": "Result",
          "type": "string"
        },
        "round": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "who": {
          "default": "",
          "title": "Who",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "item",
        "kind",
        "result"
      ],
      "title": "Check",
      "type": "object"
    },
    "Cost": {
      "description": "What a step or round cost. `usd` is optional: an agent on a subscription reports none.\n\nAn infinite figure, or a count larger than a float holds, is read and counted as absent; `NaN` is\nnot a cost and makes the line a problem, as it always did.",
      "properties": {
        "estimated": {
          "default": false,
          "title": "Estimated",
          "type": "boolean"
        },
        "tokens_cache_read": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Cache Read",
          "type": "integer"
        },
        "tokens_cache_write": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Cache Write",
          "type": "integer"
        },
        "tokens_in": {
          "default": 0,
